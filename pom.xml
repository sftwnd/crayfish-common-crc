<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.sftwnd.crayfish.common</groupId>
    <artifactId>crayfish-common-crc</artifactId>
    <version>2.1.0-SNAPSHOT</version>

    <name>CrayFish :: COMMON :: Crc</name>
    <description>
        Generic Java CRC implementation (CRC-16, CRC-32, CRC-64, etc.) with 112 predefined CRC algorithms (186 names including aliases), such as CRC-32/ISO-HDLC, CRC-64/ECMA-182 and CRC-8/SMBUS.
    </description>
    <url>https://github.com/sftwnd/crayfish-common-crc</url>

    <licenses>
        <license>
            <name>3-Clause BSD License</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ashindarev</id>
            <name>Andrey Shindarev</name>
            <email>ashindarev@gmail.com</email>
            <timezone>Europe/Moscow</timezone>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/sftwnd/crayfish-common-crc</url>
        <connection>scm:git:https://github.com/sftwnd/crayfish-common-crc.git</connection>
        <developerConnection>scm:git:git@github.com:sftwnd/crayfish-common-crc.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javaModuleName>com.github.sftwnd.crayfish_common_crc</javaModuleName>
        <spotbugs-annotations.version>4.10.5</spotbugs-annotations.version>
        <!-- JUnit 6 requires Java 17: the tests run on Java 8 as well -->
        <junit.version>5.14.4</junit.version>
        <!-- the JVM options of the tests, set by jacoco:prepare-agent; empty if JaCoCo is skipped, so that @{argLine}
             of the soft retention tests resolves -->
        <argLine />
        <!-- the sources jar is built by maven-jar-plugin (the execution attach-sources): maven-source-plugin, which
             the release profile of the super POM uses as well, is skipped, so that it attaches no sources jar of its own -->
        <maven.source.skip>true</maven.source.skip>
        <!-- 3.11.0+: compileSourceRoots can be configured, for the module descriptor in src/main/java9 -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- bnd 7 requires Java 17, the build has to run on Java 8 -->
        <bnd-maven-plugin.version>6.4.0</bnd-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <!-- the plugin version is the SpotBugs version plus a plugin revision; it analyzes with that SpotBugs (needs Java 11+) -->
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <!-- the server with the passphrase of the signing key: no such server, so the signing takes the passphrase
             from gpg-agent, see the profile sign-artifacts -->
        <gpg.serverId>gpg-agent</gpg.serverId>
    </properties>

    <dependencies>
        <!-- optional: NonNull/Nullable are CLASS-retention marker annotations, consumers need neither this jar
             nor its dependency jsr305 (package javax.annotation) to compile or to run -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <!-- JDK 21+ reports Java 8 as an obsolete target; Java 8 stays the target of the library -->
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <!-- the sources of the sources jar, which mirrors the multi-release jar: those of src/main/java at the
                     root, those of src/main/java9 in META-INF/versions/9 (copied in the profile release-8-on-jdk9+, which
                     compiles them). maven-source-plugin takes the source roots of the project, and src/main/java9 is
                     compiled by an execution of its own, not as a source root -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-sources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/sources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/java</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- an undocumented public or protected member fails the build (JDK 17+ reports it) -->
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- the integration tests run with the jar instead of target/classes: on Java 9+ the classes of
                     META-INF/versions/9 of the multi-release jar are used, as by the users of the library -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/SoftRetentionIT.java</exclude>
                        <exclude>**/JdkIT.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- the pool of the descriptions with soft references, in a JVM of its own: the retention is
                             read once, when the pool is created; the small heap lets the test run the memory short -->
                        <id>soft-retention</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/SoftRetentionIT.java</include>
                            </includes>
                            <excludes combine.self="override" />
                            <systemPropertyVariables>
                                <com.github.sftwnd.crayfish.common.crc.retention>soft</com.github.sftwnd.crayfish.common.crc.retention>
                            </systemPropertyVariables>
                            <argLine>@{argLine} -Xmx64m</argLine>
                            <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-soft-retention.xml</summaryFile>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- CRC-32 and CRC-32C calculated by the classes of the JDK, in a JVM of its own: the property is
                             read once, when the first model is created; on Java 9+ the jar gives the version of JdkCrcs
                             that knows CRC32C -->
                        <id>jdk</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/JdkIT.java</include>
                            </includes>
                            <excludes combine.self="override" />
                            <systemPropertyVariables>
                                <com.github.sftwnd.crayfish.common.crc.jdk>true</com.github.sftwnd.crayfish.common.crc.jdk>
                            </systemPropertyVariables>
                            <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-jdk.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- the Java 9 version of JdkCrcs has the name of the class it replaces: the report covers
                             the classes of target/classes -->
                        <exclude>META-INF/versions/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- OSGi bundle headers -->
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- not in target/classes: there its Automatic-Module-Name makes javac take target/classes for the module
                         when it compiles module-info.java in an incremental build -->
                    <manifestPath>${project.build.directory}/bnd/MANIFEST.MF</manifestPath>
                    <bnd><![CDATA[
Bundle-SymbolicName: com.github.sftwnd.crayfish.common.crc
Bundle-License: BSD-3-Clause;link="https://opensource.org/licenses/BSD-3-Clause"
Automatic-Module-Name: ${javaModuleName}
Multi-Release: true
# bnd 6 does not know multi-release jars and takes the classes of META-INF/versions/9 (the module descriptor and the
# Java 9 version of JdkCrcs) for classes in the wrong directory
-fixupmessages: "Classes found in the wrong directory: *META-INF/versions/9/*";restrict:=error;is:=ignore
Export-Package: com.github.sftwnd.crayfish.common.crc;version="${version;===;${Bundle-Version}}"
-noextraheaders: true
# snapshot builds get the version qualifier SNAPSHOT instead of a timestamp, so that they are reproducible
-snapshot: SNAPSHOT
]]></bnd>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.directory}/bnd/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <!-- the sources jar of the sources copied by maven-resources-plugin -->
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                            <classesDirectory>${project.build.directory}/sources</classesDirectory>
                            <!-- the default manifest, not that of the bundle -->
                            <archive combine.self="override" />
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <mavenExecutorId>forked-path</mavenExecutorId>
                    <!-- the release profile of the super POM is not used: useReleaseProfile (deprecated) is false by
                         default -->
                    <releaseProfiles>sign-artifacts</releaseProfiles>
                </configuration>
            </plugin>
            <plugin>
                <!-- deploy publishes to the Central Publisher Portal (server id "central" with a Portal user token in settings.xml) -->
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <deploymentName>${project.artifactId}-${project.version}</deploymentName>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- the release profile of the super POM (-DperformRelease=true) uses it without a version -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- skipped (maven.source.skip); the version for the release profile of the super POM -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>biz.aQute.bnd</groupId>
                    <artifactId>bnd-maven-plugin</artifactId>
                    <version>${bnd-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- SonarCloud analysis in the GitHub Actions workflow -->
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs-annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <!-- compile against the Java 8 API on JDK 9+ (-source/-target alone do not check the API) -->
            <id>release-8-on-jdk9+</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <!-- the module descriptor, compiled for Java 9 into META-INF/versions/9: a named module on
                             Java 9+, while Java 8 ignores it (a build on JDK 8 produces a jar without it) -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-module-info</id>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>9</release>
                                    <multiReleaseOutput>true</multiReleaseOutput>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java9</compileSourceRoot>
                                    </compileSourceRoots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- the sources of src/main/java9 in the sources jar, in META-INF/versions/9 as their classes in
                             the jar -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-sources-9</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/sources/META-INF/versions/9</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/main/java9</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- SpotBugs itself runs on Java 11+, so the build on JDK 8 skips the analysis: the classes are the same
                 Java 8 bytecode (release 8) on every JDK -->
            <id>spotbugs</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <!-- a finding fails the build, and the tests are not analyzed: the defaults of failOnError and
                             includeTests -->
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>sign-artifacts</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <!-- a jar built on JDK 8 has no module descriptor -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>release-on-jdk9+</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion>
                                            <version>[9,)</version>
                                            <message>A release has to be built on JDK 9+, so that the jar contains the module descriptor</message>
                                        </requireJavaVersion>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!-- the passphrase of the key comes from gpg-agent: before the release unlock the key
                                         with any signature of gpg outside of the batch mode, so that gpg-agent caches it.
                                         In batch mode the plugin runs gpg with the pinentry mode "error": a locked key fails
                                         without a prompt. Without a server id the plugin takes the passphrase of the server
                                         gpg.passphrase of .mvn/settings.xml (GPG_SIGNING_PASSPHRASE): the id names a server
                                         that does not exist, and -Dgpg.serverId=gpg.passphrase takes that passphrase
                                         instead -->
                                    <passphraseServerId>${gpg.serverId}</passphraseServerId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>