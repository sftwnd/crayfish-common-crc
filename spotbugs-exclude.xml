<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs filter: every exclusion is a decision of the design, scoped to the class, the field or the method -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.10.5/spotbugs/etc/findbugsfilter.xsd">

    <!-- the names of a description are unmodifiable lists: those of StandardCrc (Collections.unmodifiableList),
         or Collections.singletonList and Collections.emptyList for parameters outside the catalogue -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.github.sftwnd.crayfish.common.crc.CrcDescription"/>
        <Or>
            <Method name="names"/>
            <Method name="aliases"/>
        </Or>
    </Match>

</FindBugsFilter>
